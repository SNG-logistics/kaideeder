// DELIVERY ENUMS
// ─────────────────────────────────────────────

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum DeliveryStatus {
  RECEIVED
  PREPARING
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryChannel {
  WHATSAPP
  LINE
  PHONE
  WALKIN
