  TOPUP
  RENT_FEE
  ADJUST
  REFUND
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActorType {
  ADMIN
  TENANT_USER
}

enum ProductType {
  SALE_ITEM
  RAW_MATERIAL
  PREP           // ของเตรียม/แปรรูป (น้ำซุป, ซอส, หมูหมัก)
  PACKAGING
  ENTERTAIN
}

enum LocationType {
  MAIN_WAREHOUSE
  FRESH_STORAGE
  DRINK_WAREHOUSE
  DISPLAY_FREEZER
  KITCHEN_STOCK
  BAR_STOCK
}

enum MovementType {
  PURCHASE
  TRANSFER
  SALE
  ADJUSTMENT
  WASTE
  OPENING
  RETURN
  PRODUCTION_OUT   // ตัดวัตถุดิบดิบเพื่อแปรรูป
  PRODUCTION_IN    // รับ PREP product เข้าคลัง
}

// ─────────────────────────────────────────────
// PLATFORM CONFIGURATION (Global)
// ─────────────────────────────────────────────

model PlatformConfig {
  key       String   @id // e.g., 'REGISTER_URL', 'CONTACT_URL'
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?  // adminId

  @@map("platform_config")
}

enum POStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalesImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING_CONFIRM
  OPEN
  CLOSED
  CANCELLED
  VOID
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum KitchenStatus {
  PENDING
  ACCEPTED
  COOKING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  QRCODE
}

enum SkuSuggestionStatus {
  PENDING
  APPROVED_MAP  // อนุมัติ map ไป existing SKU
  APPROVED_NEW  // อนุมัติสร้าง SKU ใหม่
  REJECTED
}

enum ConsumeFailType {
  NO_BOM           // เมนูไม่มีสูตร BOM เลย
  BOM_INCOMPLETE   // BOM มีบางรายการขาด qty/unit
  NO_UOM_CONV      // ไม่มีหน่วยแปลง (เช่น ถุง→กรัม)
  STOCK_EMPTY      // สต็อคใน location ไม่พอ
  WRONG_WAREHOUSE  // ของมีแต่อยู่คลังอื่น
  NO_GR            // สินค้ายังไม่ได้รับเข้าคลัง (inventory record = 0)
  SYSTEM_ERROR     // ข้อผิดพลาดระบบอื่นๆ
}

enum FailLogStatus {
  OPEN       // รอดำเนินการ
  RESOLVED   // แก้ไขแล้ว
  IGNORED    // ยกเลิก/ข้ามไป
}

enum StockCountStatus {
  DRAFT        // เตรียมรายการ
  IN_PROGRESS  // กำลังนับ (systemQty ถูก snapshot แล้ว)
  COMPLETED    // นับครบทุกรายการ รอ Approve
  ADJUSTED     // Apply adjustment เข้าระบบแล้ว
  CANCELLED
}

